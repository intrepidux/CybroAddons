<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_attendance_geofence_tree" model="ir.ui.view">
        <field name="name">hr.attendance.geofence.tree</field>
        <field name="model">hr.attendance.geofence</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="radius_m"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_hr_attendance_geofence_form" model="ir.ui.view">
        <field name="name">hr.attendance.geofence.form</field>
        <field name="model">hr.attendance.geofence</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                    <group string="Circle">
                        <field name="center_latitude"/>
                        <field name="center_longitude"/>
                        <field name="radius_m"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_attendance_geofence" model="ir.actions.act_window">
        <field name="name">Geofences</field>
        <field name="res_model">hr.attendance.geofence</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_hr_attendance_geofence"
              name="Geofences"
              parent="hr_zk_attendance.zk_machine_menu"
              action="action_hr_attendance_geofence"
              sequence="5"/>
</odoo>
