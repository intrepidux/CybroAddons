<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_kiosk_devices" model="ir.ui.view">
        <field name="name">hr.employee.form.kiosk.devices</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='device_id']" position="after">
                <field name="allowed_machine_ids" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>
</odoo>
