<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_kiosk_camera" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.kiosk.camera</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='pincode_setting_container']" position="after">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="attendance_kiosk_use_camera"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="attendance_kiosk_use_camera"/>
                        <div class="text-muted">
                            Show camera preview on kiosk (HTTPS; BarcodeDetector API).
                        </div>
                        <div class="mt16" attrs="{'invisible': [('attendance_kiosk_use_camera', '=', False)]}">
                            <field name="attendance_kiosk_camera_facing"/>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="attendance_kiosk_hide_manual"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="attendance_kiosk_hide_manual"/>
                        <div class="text-muted">
                            Hide &quot;Identify manually&quot; on kiosk; scan only.
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
